---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

export interface Props {
  title: string;
  activeNav?: string;
}
const { title, activeNav = "" } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Anton&family=Cinzel:wght@500;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,500&family=MedievalSharp&family=Kalam:wght@400;700&family=Work+Sans:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <Header active={activeNav} />
  <slot />
  <Footer />
</body>
</html>
