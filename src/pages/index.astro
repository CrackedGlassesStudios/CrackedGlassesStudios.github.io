---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Cracked Glasses Studios" activeNav="">
  <main id="top">
    <section class="hero">
      <div class="wrap hero-inner">
        <img
          class="logo"
          src="/assets/images/cracked-glasses-logo.png"
          alt="Cracked Glasses Studios"
        />
        <div class="eyebrow">
          an indie studio, held together with duct tape &amp; ambition
        </div>
        <h1 class="title">Cracked Glasses Studios</h1>
        <p class="sub">
          We build handcrafted games with a little too much heart. First up: an
          alchemist, a cluttered workshop, and more chaos than any potion should
          cause.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#games"
            >Meet The Alchemist's Assistant</a
          >
          <a class="btn btn-ghost" href="#about">About the Studio</a>
        </div>
      </div>
    </section>

    <section class="section feature" id="games">
      <div class="wrap feature-grid">
        <div class="art-frame">
          <img
            src="/assets/images/alchemists-assistant-hero.png"
            alt="The Alchemist's Assistant key art"
          />
        </div>
        <div>
          <span class="tag">Flagship Project</span>
          <h2 class="feature-title">The Alchemist's Assistant</h2>
          <p>
            An unruly potion-brewing adventure where one wrong ingredient turns
            your workshop upside down. Currently in active development &mdash;
            this is where most of our chaos, and our love, is going right now.
          </p>
          <a class="btn btn-primary" href="/games/the-alchemists-assistant"
            >View Game Page</a
          >
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <span class="section-label">what's brewing next</span>
        <h2>From the Workshop</h2>
        <div class="more-grid">
          <div class="card">
            <div class="dot" style="background:#6fe0ab"></div>
            <h3>The Alchemist's Assistant</h3>
            <p>In development. Follow along as the workshop takes shape.</p>
          </div>
          <div class="card">
            <div class="dot" style="background:#9a7de0"></div>
            <h3>Next Project</h3>
            <p>
              Nothing brewing here yet &mdash; this slot is reserved for
              whatever we cook up next.
            </p>
          </div>
          <div class="card">
            <div class="dot" style="background:#5c7fe0"></div>
            <h3>Dev Blog</h3>
            <p>
              Notes, screenshots, and behind-the-scenes chaos from the studio.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section about-section" id="about">
      <div class="wrap about-strip">
        <div>
          <span class="section-label">who we are</span>
          <h2>A Small, Handcrafted Studio</h2>
          <p>
            Cracked Glasses Studios is a small, independent game studio focused
            on atmospheric, character-driven games. No corporate polish, no
            template feel &mdash; just games built by hand, one cracked lens at
            a time.
          </p>
          <a class="btn btn-ghost" href="/about">Read our story</a>
        </div>
        <p class="quote">
          "Everything's a little cracked around here. That's kind of the point."
        </p>
      </div>
    </section>
  </main>
</MainLayout>

<style>
  .wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hero {
    position: relative;
    padding: 110px 0 90px;
    overflow: hidden;
    background:
      radial-gradient(
        ellipse 60% 50% at 20% 10%,
        rgba(92, 127, 224, 0.2),
        transparent 60%
      ),
      radial-gradient(
        ellipse 55% 45% at 85% 20%,
        rgba(31, 122, 140, 0.22),
        transparent 60%
      ),
      radial-gradient(
        ellipse 70% 60% at 50% 100%,
        rgba(111, 224, 171, 0.1),
        transparent 65%
      ),
      #0e1014;
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      rgba(242, 237, 225, 0.5) 1px,
      transparent 1px
    );
    background-size: 34px 34px;
    opacity: 0.06;
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 22px;
  }
  .hero img.logo {
    width: min(230px, 55vw);
    filter: drop-shadow(0 8px 30px rgba(0, 0, 0, 0.5));
  }
  .eyebrow {
    font-family: "Kalam", cursive;
    color: #4fd6d6;
    font-size: 1.15rem;
    transform: rotate(-2deg);
  }
  h1.title {
    font-family: "Anton", sans-serif;
    font-weight: 400;
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    line-height: 1.02;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    background: linear-gradient(
      100deg,
      #5c7fe0,
      #6fe0ab 45%,
      #4fd6d6 75%,
      #9a7de0
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .sub {
    max-width: 560px;
    color: #b8b4a8;
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0 auto;
  }
  .cta-row {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 6px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 26px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.3px;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  .btn-primary {
    background: linear-gradient(120deg, #5c7fe0, #1f7a8c);
    color: #0e1014;
    box-shadow: 0 6px 24px rgba(31, 122, 140, 0.35);
  }
  .btn-primary:hover {
    transform: translateY(-2px);
  }
  .btn-ghost {
    border: 1px solid rgba(242, 237, 225, 0.14);
  }
  .btn-ghost:hover {
    border-color: #4fd6d6;
    color: #4fd6d6;
  }

  .section {
    padding: 90px 0;
  }
  .section-label {
    font-family: "Kalam", cursive;
    color: #6fe0ab;
    font-size: 1rem;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
    transform: rotate(-1deg);
    display: inline-block;
  }
  .section h2 {
    font-family: "Anton", sans-serif;
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    letter-spacing: 0.4px;
    margin-bottom: 14px;
  }

  .feature {
    background: #161922;
    border-top: 1px solid rgba(242, 237, 225, 0.14);
    border-bottom: 1px solid rgba(242, 237, 225, 0.14);
  }
  .feature-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 52px;
    align-items: center;
  }
  @media (max-width: 860px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
  }
  .art-frame {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(242, 237, 225, 0.14);
    background:
      radial-gradient(
        circle at 30% 20%,
        rgba(111, 224, 171, 0.35),
        transparent 55%
      ),
      radial-gradient(
        circle at 75% 70%,
        rgba(92, 127, 224, 0.35),
        transparent 55%
      ),
      linear-gradient(160deg, #1a1e2a, #11141c);
    aspect-ratio: 4/3;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .art-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #1f7a8c;
    background: rgba(31, 122, 140, 0.14);
    border: 1px solid rgba(31, 122, 140, 0.4);
    padding: 4px 10px;
    border-radius: 999px;
    margin-bottom: 14px;
  }
  .feature p {
    color: #b8b4a8;
    line-height: 1.7;
    margin: 14px 0 22px;
    max-width: 480px;
  }
  .feature-title {
    font-family: "Anton", sans-serif;
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
  }

  .more-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 22px;
    margin-top: 36px;
  }
  .card {
    background: #1b1f2a;
    border: 1px solid rgba(242, 237, 225, 0.14);
    border-radius: 12px;
    padding: 26px;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .card:hover {
    border-color: #9a7de0;
    transform: translateY(-3px);
  }
  .card h3 {
    font-family: "Anton", sans-serif;
    font-weight: 400;
    text-transform: uppercase;
    font-size: 1.15rem;
    margin-bottom: 8px;
    letter-spacing: 0.3px;
  }
  .card p {
    color: #b8b4a8;
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .card .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-bottom: 14px;
  }

  .about-section {
    background: #161922;
    border-top: 1px solid rgba(242, 237, 225, 0.14);
    border-bottom: 1px solid rgba(242, 237, 225, 0.14);
  }
  .about-strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  @media (max-width: 820px) {
    .about-strip {
      grid-template-columns: 1fr;
    }
  }
  .about-strip p {
    color: #b8b4a8;
    line-height: 1.75;
    margin-bottom: 14px;
  }
  .quote {
    font-family: "Kalam", cursive;
    font-size: 1.3rem;
    color: #f2ede1;
    line-height: 1.4;
    transform: rotate(-1deg);
    border-left: 3px solid #6fe0ab;
    padding-left: 18px;
  }
</style>
